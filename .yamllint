# yamllint 設定。
#
# CI では Fandhe-AI/actions の lint-docs reusable workflow（yamllint）が
# 自動探索（.yamllint）で本ファイルを参照する。既定ルールのうち
# GitHub Actions workflow・組織の既存慣行と衝突するものだけを緩和する
# （agent-cli-skills の同名設定と同方針）。
extends: default

# upstream 配布のスキル実体（修正先は agent-cli-skills）と private submodule は
# lint 対象から除外する
ignore: |
  _/
  .claude/
  .agents/skills/
  docs/spec/
  node_modules/

rules:
  # GitHub Actions workflow は先頭の `---` を書かない慣行のため要求しない
  document-start: disable
  # workflow の `on:` キーが truthy 判定されるのを除外する（値側の検査は維持）
  truthy:
    check-keys: false
  # SHA 固定の `uses:` 行・日本語コメント等があり既定の 80 桁では過剰
  line-length:
    max: 120
  # `uses: ...@<SHA> # vX.Y.Z` の固定注記はコメント前スペース 1 の
  # 組織横断の既存慣行（actions リポジトリのテンプレート由来）のため許容する
  comments:
    min-spaces-from-content: 1
